# Copy to .github/workflows/ci.yml after granting GitHub workflow write permission.
name: Test and build
on: [push, pull_request]
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        node: [22, 24]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}
          cache: npm
      - run: npm ci
      - run: npm run privacy:check
      - run: npm test
        env:
          TZ: UTC
      - run: npm run build
