# 不填以下两项即可进入演示模式，快速体验不需要复制此文件。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# spsport / spsport-large / 自己注册的场馆 ID（只用于演示）
VITE_VENUE=spsport
# 可选：连接了数据库时仍强制使用演示模式
VITE_DEMO_MODE=false
# shopify / stripe
VITE_PAYMENT_PROVIDER=shopify

# 服务端密钥只配置在 Supabase secrets，绝不能加 VITE_ 前缀：
# SUPABASE_SERVICE_ROLE_KEY, SITE_URL
# SHOPIFY_STORE_DOMAIN, SHOPIFY_STOREFRONT_TOKEN, SHOPIFY_ADMIN_TOKEN,
# SHOPIFY_WEBHOOK_SECRET
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
